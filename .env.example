DATABASE_URL=postgresql://app:app@localhost:5432/studyreader
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
# At least 16 bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEILI_MASTER_KEY=change-me
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# At least 32 characters. Generate with: npx auth secret
AUTH_SECRET=change-me
# Production behind a reverse proxy (nginx, Plesk): set AUTH_URL to the public URL,
# or uncomment AUTH_TRUST_HOST. Any value, even "false", turns trust on.
# AUTH_URL=https://studyreader.example.com
# AUTH_TRUST_HOST=true
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
RETENTION_DAYS=365
